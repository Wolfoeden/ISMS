{
  "name": "isms-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ISMS- und Delivery-Plattform: Domänenkern für Engagement & Proportionality Model",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "isms": "tsx src/werkzeuge/cli.ts",
    "test:api": "bash scripts/with-db.sh npx vitest run test/api",
    "api": "tsx src/api/server.ts",
    "prototyp": "bash scripts/prototyp.sh",
    "ui:durchlauf": "node scripts/ui-durchlauf.cjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.11.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "pg": "8.13.1"
  }
}
