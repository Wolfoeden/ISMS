  <process id="Process_AssessmentExecution" name="Reusable Assessment Execution (parameterized by type)" isExecutable="false">
    <documentation>Descriptive L0/L1 reference. isExecutable=false. Execution requires message correlation, services, DMN bindings, explicit policies, exception/timeout handling and authorization. See Markdown specifications.</documentation>
    <laneSet id="LaneSet_Assessment">
      <lane id="Lane_Assess_Agent" name="Agents / Services">
        <flowNodeRef>A_Start</flowNodeRef>
        <flowNodeRef>A_AssessEvidence</flowNodeRef>
        <flowNodeRef>A_Propose</flowNodeRef>
        <flowNodeRef>A_Enough</flowNodeRef>
        <flowNodeRef>A_Persist</flowNodeRef>
        <flowNodeRef>A_End</flowNodeRef>
      </lane>
      <lane id="Lane_Assess_Human" name="Assessor / Senior Consultant">
        <flowNodeRef>A_Verify</flowNodeRef>
        <flowNodeRef>A_Clarify</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="A_Start" name="Assessment gestartet">
      <outgoing>Flow_A_Start__A_AssessEvidence</outgoing>
    </startEvent>
    <serviceTask id="A_AssessEvidence" name="Kontrollen, Kriterien und Nachweise analysieren">
      <incoming>Flow_A_Start__A_AssessEvidence</incoming>
      <incoming>Flow_A_Clarify__A_AssessEvidence</incoming>
      <outgoing>Flow_A_AssessEvidence__A_Propose</outgoing>
    </serviceTask>
    <serviceTask id="A_Propose" name="Findings, Risiken &amp; Massnahmen vorschlagen">
      <incoming>Flow_A_AssessEvidence__A_Propose</incoming>
      <outgoing>Flow_A_Propose__A_Verify</outgoing>
    </serviceTask>
    <userTask id="A_Verify" name="Findings und Risiken fachlich verifizieren">
      <incoming>Flow_A_Propose__A_Verify</incoming>
      <outgoing>Flow_A_Verify__A_Enough</outgoing>
    </userTask>
    <exclusiveGateway id="A_Enough" name="Assessorentscheid reif?">
      <incoming>Flow_A_Verify__A_Enough</incoming>
      <outgoing>Flow_A_Enough__A_Clarify</outgoing>
      <outgoing>Flow_A_Enough__A_Persist</outgoing>
    </exclusiveGateway>
    <userTask id="A_Clarify" name="Gezielte Nacherhebung / Fachklaerung">
      <incoming>Flow_A_Enough__A_Clarify</incoming>
      <outgoing>Flow_A_Clarify__A_AssessEvidence</outgoing>
    </userTask>
    <serviceTask id="A_Persist" name="Verifizierte Findings versioniert sichern">
      <incoming>Flow_A_Enough__A_Persist</incoming>
      <outgoing>Flow_A_Persist__A_End</outgoing>
    </serviceTask>
    <endEvent id="A_End" name="Assessment bearbeitet">
      <incoming>Flow_A_Persist__A_End</incoming>
    </endEvent>
    <sequenceFlow id="Flow_A_Start__A_AssessEvidence" sourceRef="A_Start" targetRef="A_AssessEvidence"/>
    <sequenceFlow id="Flow_A_AssessEvidence__A_Propose" sourceRef="A_AssessEvidence" targetRef="A_Propose"/>
    <sequenceFlow id="Flow_A_Propose__A_Verify" sourceRef="A_Propose" targetRef="A_Verify"/>
