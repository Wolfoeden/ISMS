<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DTAgency_IntelligentAssessment_v1" targetNamespace="https://dt-agency.example/bpmn/assessment/v1" exporter="DT Agency architecture specification" exporterVersion="1.0">
  <message id="Msg_candidate" name="CandidateAccepted"/>
  <message id="Msg_inbound" name="InboundAssessmentRequest"/>
  <message id="Msg_discovery_questions" name="AdaptiveDiscoveryQuestions"/>
  <message id="Msg_discovery_response" name="CustomerDiscoveryContext"/>
  <message id="Msg_outreach" name="OutboundContactInvitation"/>
  <message id="Msg_reaction" name="CustomerContactResponse"/>
  <message id="Msg_offer" name="AssessmentProposal"/>
  <message id="Msg_signed" name="SignedMandate"/>
  <message id="Msg_decline" name="MandateDeclined"/>
  <message id="Msg_changes" name="MandateChangeRequest"/>
  <message id="Msg_clarify" name="EvidenceClarificationRequest"/>
  <message id="Msg_clarification" name="EvidenceClarificationResponse"/>
  <message id="Msg_report" name="FinalAssessmentReport"/>
  <collaboration id="Collab_DTAgency_IntelligentAssessment" name="Opportunity to Assessment: customer, discovery and delivery">
    <participant id="Participant_Customer" name="Kunde / Interessent (Black Box)"/>
    <participant id="Participant_Discovery" name="DT Agency / Prospecting Run" processRef="Process_DiscoveryRun"/>
    <participant id="Participant_Case" name="DT Agency / Assessment Case" processRef="Process_OpportunityToAssessment"/>
    <messageFlow id="Message_Candidate" sourceRef="D_Publish" targetRef="Start_Candidate" messageRef="Msg_candidate"/>
    <messageFlow id="Message_Inbound" sourceRef="Participant_Customer" targetRef="Start_Inbound" messageRef="Msg_inbound"/>
    <messageFlow id="Message_DiscoveryQuestions" sourceRef="T_SendDiscovery" targetRef="Participant_Customer" messageRef="Msg_discovery_questions"/>
    <messageFlow id="Message_DiscoveryContext" sourceRef="Participant_Customer" targetRef="Catch_DiscoveryContext" messageRef="Msg_discovery_response"/>
    <messageFlow id="Message_Outreach" sourceRef="T_SendContact" targetRef="Participant_Customer" messageRef="Msg_outreach"/>
    <messageFlow id="Message_CustomerResponse" sourceRef="Participant_Customer" targetRef="Catch_Reaction" messageRef="Msg_reaction"/>
    <messageFlow id="Message_Offer" sourceRef="T_SendOffer" targetRef="Participant_Customer" messageRef="Msg_offer"/>
    <messageFlow id="Message_Signed" sourceRef="Participant_Customer" targetRef="Catch_Signed" messageRef="Msg_signed"/>
    <messageFlow id="Message_Declined" sourceRef="Participant_Customer" targetRef="Catch_OfferDecline" messageRef="Msg_decline"/>
    <messageFlow id="Message_Changes" sourceRef="Participant_Customer" targetRef="Catch_OfferChange" messageRef="Msg_changes"/>
    <messageFlow id="Message_ClarificationReq" sourceRef="T_RequestEvidence" targetRef="Participant_Customer" messageRef="Msg_clarify"/>
    <messageFlow id="Message_ClarificationResponse" sourceRef="Participant_Customer" targetRef="Catch_Clarification" messageRef="Msg_clarification"/>
    <messageFlow id="Message_Report" sourceRef="T_Publish" targetRef="Participant_Customer" messageRef="Msg_report"/>
  </collaboration>
  <process id="Process_DiscoveryRun" name="Proactive Discovery Run (0..n candidates)" isExecutable="false">
    <documentation>Descriptive L0/L1 reference. isExecutable=false. Execution requires message correlation, services, DMN bindings, explicit policies, exception/timeout handling and authorization. See Markdown specifications.</documentation>
    <startEvent id="D_Start" name="Suchlauf gestartet">
      <outgoing>Flow_D_Start__D_Policy</outgoing>
    </startEvent>
    <businessRuleTask id="D_Policy" name="Quellen- und Datenschutzregeln pruefen">
      <incoming>Flow_D_Start__D_Policy</incoming>
      <outgoing>Flow_D_Policy__D_Find</outgoing>
    </businessRuleTask>
    <serviceTask id="D_Find" name="Rechtmaessige Marktsignale erfassen &amp; deduplizieren">
      <incoming>Flow_D_Policy__D_Find</incoming>
      <outgoing>Flow_D_Find__D_Publish</outgoing>
    </serviceTask>
    <serviceTask id="D_Publish" name="Je Candidate eine Nachricht / Case-Korrelation erzeugen">
      <incoming>Flow_D_Find__D_Publish</incoming>
      <outgoing>Flow_D_Publish__D_End</outgoing>
      <multiInstanceLoopCharacteristics id="MI_DiscoveryCandidates" isSequential="false">
        <loopCardinality>candidateCount</loopCardinality>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <endEvent id="D_End" name="Discovery Run abgeschlossen">
      <incoming>Flow_D_Publish__D_End</incoming>
    </endEvent>
    <sequenceFlow id="Flow_D_Start__D_Policy" sourceRef="D_Start" targetRef="D_Policy"/>
    <sequenceFlow id="Flow_D_Policy__D_Find" sourceRef="D_Policy" targetRef="D_Find"/>
    <sequenceFlow id="Flow_D_Find__D_Publish" sourceRef="D_Find" targetRef="D_Publish"/>
    <sequenceFlow id="Flow_D_Publish__D_End" sourceRef="D_Publish" targetRef="D_End"/>
  </process>
  <process id="Process_OpportunityToAssessment" name="One opportunity / mandate / assessment case" isExecutable="false">
    <documentation>Descriptive L0/L1 reference. isExecutable=false. Execution requires message correlation, services, DMN bindings, explicit policies, exception/timeout handling and authorization. See Markdown specifications.</documentation>
    <laneSet id="Lanes_Case">
      <lane id="Lane_Platform" name="Plattform / Agents / Decision Services">
        <flowNodeRef>Start_Candidate</flowNodeRef>
        <flowNodeRef>Start_Inbound</flowNodeRef>
        <flowNodeRef>T_Intake</flowNodeRef>
        <flowNodeRef>G_Route</flowNodeRef>
        <flowNodeRef>T_PublicContext</flowNodeRef>
        <flowNodeRef>T_PreScreen</flowNodeRef>
        <flowNodeRef>G_Qualified</flowNodeRef>
        <flowNodeRef>End_NotQualified</flowNodeRef>
        <flowNodeRef>T_OutreachRules</flowNodeRef>
        <flowNodeRef>G_Outreach</flowNodeRef>
        <flowNodeRef>End_NoOutreach</flowNodeRef>
        <flowNodeRef>T_SendContact</flowNodeRef>
        <flowNodeRef>G_Response</flowNodeRef>
        <flowNodeRef>Catch_Reaction</flowNodeRef>
        <flowNodeRef>Catch_NoReaction</flowNodeRef>
        <flowNodeRef>End_NoReaction</flowNodeRef>
        <flowNodeRef>G_Interested</flowNodeRef>
        <flowNodeRef>End_DeclinedContact</flowNodeRef>
        <flowNodeRef>G_Join</flowNodeRef>
        <flowNodeRef>T_Discovery</flowNodeRef>
        <flowNodeRef>T_SendDiscovery</flowNodeRef>
        <flowNodeRef>G_DiscoveryWait</flowNodeRef>
        <flowNodeRef>Catch_DiscoveryContext</flowNodeRef>
        <flowNodeRef>Catch_DiscoveryTimeout</flowNodeRef>
        <flowNodeRef>End_ContextTimeout</flowNodeRef>
        <flowNodeRef>T_FrameworkPreview</flowNodeRef>
        <flowNodeRef>T_SendOffer</flowNodeRef>
        <flowNodeRef>G_OfferWait</flowNodeRef>
        <flowNodeRef>Catch_Signed</flowNodeRef>
        <flowNodeRef>Catch_OfferDecline</flowNodeRef>
        <flowNodeRef>End_OfferDeclined</flowNodeRef>
        <flowNodeRef>T_CreateMandate</flowNodeRef>
        <flowNodeRef>T_EvidenceIntake</flowNodeRef>
        <flowNodeRef>T_Readiness</flowNodeRef>
        <flowNodeRef>G_Ready</flowNodeRef>
        <flowNodeRef>T_RequestEvidence</flowNodeRef>
        <flowNodeRef>G_ClarifyWait</flowNodeRef>
        <flowNodeRef>Catch_Clarification</flowNodeRef>
        <flowNodeRef>Call_Configure</flowNodeRef>
        <flowNodeRef>Call_Assess</flowNodeRef>
        <flowNodeRef>T_Draft</flowNodeRef>
        <flowNodeRef>T_Completion</flowNodeRef>
        <flowNodeRef>G_Complete</flowNodeRef>
        <flowNodeRef>T_Rework</flowNodeRef>
        <flowNodeRef>G_Rework</flowNodeRef>
        <flowNodeRef>G_QA</flowNodeRef>
        <flowNodeRef>T_Publish</flowNodeRef>
        <flowNodeRef>G_FinalType</flowNodeRef>
        <flowNodeRef>End_Completed</flowNodeRef>
        <flowNodeRef>End_Limited</flowNodeRef>
      </lane>
      <lane id="Lane_Consulting" name="Engagement Lead / Consultant / Analyst">
        <flowNodeRef>T_Qualify</flowNodeRef>
        <flowNodeRef>T_ApproveOutreach</flowNodeRef>
        <flowNodeRef>G_ContactApproved</flowNodeRef>
        <flowNodeRef>End_NoContactApproval</flowNodeRef>
        <flowNodeRef>T_ProvisionalScope</flowNodeRef>
        <flowNodeRef>Catch_OfferChange</flowNodeRef>
        <flowNodeRef>Catch_OfferTimeout</flowNodeRef>
        <flowNodeRef>End_OfferExpired</flowNodeRef>
        <flowNodeRef>T_FinalScope</flowNodeRef>
        <flowNodeRef>Catch_ClarifyTimeout</flowNodeRef>
        <flowNodeRef>T_MaterialDecision</flowNodeRef>
        <flowNodeRef>G_Limit</flowNodeRef>
        <flowNodeRef>End_Stopped</flowNodeRef>
        <flowNodeRef>T_LeadReview</flowNodeRef>
        <flowNodeRef>End_QAStop</flowNodeRef>
      </lane>
      <lane id="Lane_QA" name="Reviewer / QA / Freigabe">
        <flowNodeRef>T_QA</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Candidate" name="Candidate eingegangen">
      <outgoing>Flow_Start_Candidate__T_Intake</outgoing>
      <messageEventDefinition id="Def_Start_Candidate" messageRef="Msg_candidate"/>
    </startEvent>
    <startEvent id="Start_Inbound" name="Kundenanfrage eingegangen">
      <outgoing>Flow_Start_Inbound__T_Intake</outgoing>
      <messageEventDefinition id="Def_Start_Inbound" messageRef="Msg_inbound"/>
    </startEvent>
    <serviceTask id="T_Intake" name="Intake Case und Entry Route normalisieren">
      <incoming>Flow_Start_Candidate__T_Intake</incoming>
      <incoming>Flow_Start_Inbound__T_Intake</incoming>
      <outgoing>Flow_T_Intake__G_Route</outgoing>
    </serviceTask>
    <exclusiveGateway id="G_Route" name="Proaktiver Candidate?">
      <incoming>Flow_T_Intake__G_Route</incoming>
      <outgoing>Flow_G_Route__T_PublicContext</outgoing>
      <outgoing>Flow_G_Route__G_Join</outgoing>
    </exclusiveGateway>
    <serviceTask id="T_PublicContext" name="Zulaessige oeffentliche Fakten &amp; Signale strukturieren">
      <incoming>Flow_G_Route__T_PublicContext</incoming>
      <outgoing>Flow_T_PublicContext__T_PreScreen</outgoing>
    </serviceTask>
    <businessRuleTask id="T_PreScreen" name="Indikative Bedarfsindikatoren bestimmen">
      <incoming>Flow_T_PublicContext__T_PreScreen</incoming>
      <outgoing>Flow_T_PreScreen__T_Qualify</outgoing>
    </businessRuleTask>
    <userTask id="T_Qualify" name="Opportunity fachlich qualifizieren">
      <incoming>Flow_T_PreScreen__T_Qualify</incoming>
      <outgoing>Flow_T_Qualify__G_Qualified</outgoing>
    </userTask>
    <exclusiveGateway id="G_Qualified" name="Bedarf und Fit?">
      <incoming>Flow_T_Qualify__G_Qualified</incoming>
      <outgoing>Flow_G_Qualified__End_NotQualified</outgoing>
      <outgoing>Flow_G_Qualified__T_OutreachRules</outgoing>
    </exclusiveGateway>
    <endEvent id="End_NotQualified" name="Nicht qualifiziert">
      <incoming>Flow_G_Qualified__End_NotQualified</incoming>
    </endEvent>
    <businessRuleTask id="T_OutreachRules" name="Kontaktkanal rechtlich pruefen">
      <incoming>Flow_G_Qualified__T_OutreachRules</incoming>
      <outgoing>Flow_T_OutreachRules__G_Outreach</outgoing>
    </businessRuleTask>
    <exclusiveGateway id="G_Outreach" name="Outreach zulaessig?">
      <incoming>Flow_T_OutreachRules__G_Outreach</incoming>
      <outgoing>Flow_G_Outreach__End_NoOutreach</outgoing>
      <outgoing>Flow_G_Outreach__T_ApproveOutreach</outgoing>
    </exclusiveGateway>
    <endEvent id="End_NoOutreach" name="Keine erlaubte Kontaktaufnahme">
      <incoming>Flow_G_Outreach__End_NoOutreach</incoming>
    </endEvent>
    <userTask id="T_ApproveOutreach" name="Kontaktaufnahme pruefen und entscheiden">
      <incoming>Flow_G_Outreach__T_ApproveOutreach</incoming>
      <outgoing>Flow_T_ApproveOutreach__G_ContactApproved</outgoing>
    </userTask>
    <exclusiveGateway id="G_ContactApproved" name="Freigegeben?">
      <incoming>Flow_T_ApproveOutreach__G_ContactApproved</incoming>
      <outgoing>Flow_G_ContactApproved__End_NoContactApproval</outgoing>
      <outgoing>Flow_G_ContactApproved__T_SendContact</outgoing>
    </exclusiveGateway>
    <endEvent id="End_NoContactApproval" name="Kontaktaufnahme abgelehnt">
      <incoming>Flow_G_ContactApproved__End_NoContactApproval</incoming>
    </endEvent>
    <sendTask id="T_SendContact" name="Einladung / Kontakt senden" messageRef="Msg_outreach">
      <incoming>Flow_G_ContactApproved__T_SendContact</incoming>
      <outgoing>Flow_T_SendContact__G_Response</outgoing>
    </sendTask>
    <eventBasedGateway id="G_Response" name="Auf Kundenreaktion warten">
      <incoming>Flow_T_SendContact__G_Response</incoming>
      <outgoing>Flow_G_Response__Catch_Reaction</outgoing>
      <outgoing>Flow_G_Response__Catch_NoReaction</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Catch_Reaction" name="Kundenreaktion">
      <incoming>Flow_G_Response__Catch_Reaction</incoming>
      <outgoing>Flow_Catch_Reaction__G_Interested</outgoing>
      <messageEventDefinition id="Def_Catch_Reaction" messageRef="Msg_reaction"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_NoReaction" name="Antwortfrist erreicht">
      <incoming>Flow_G_Response__Catch_NoReaction</incoming>
      <outgoing>Flow_Catch_NoReaction__End_NoReaction</outgoing>
      <timerEventDefinition id="TimerDef_Catch_NoReaction">
        <timeDuration>P14D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <endEvent id="End_NoReaction" name="Ohne Rueckmeldung / Beobachtung">
      <incoming>Flow_Catch_NoReaction__End_NoReaction</incoming>
    </endEvent>
    <exclusiveGateway id="G_Interested" name="Interesse bestaetigt?">
      <incoming>Flow_Catch_Reaction__G_Interested</incoming>
      <outgoing>Flow_G_Interested__End_DeclinedContact</outgoing>
      <outgoing>Flow_G_Interested__G_Join</outgoing>
    </exclusiveGateway>
    <endEvent id="End_DeclinedContact" name="Kein Interesse / Suppression pruefen">
      <incoming>Flow_G_Interested__End_DeclinedContact</incoming>
    </endEvent>
    <exclusiveGateway id="G_Join" name="Bedarf klaeren">
      <incoming>Flow_G_Interested__G_Join</incoming>
      <incoming>Flow_G_Route__G_Join</incoming>
      <outgoing>Flow_G_Join__T_Discovery</outgoing>
    </exclusiveGateway>
    <serviceTask id="T_Discovery" name="Context- und Objekt-Hypothesen strukturieren">
      <incoming>Flow_G_Join__T_Discovery</incoming>
      <outgoing>Flow_T_Discovery__T_SendDiscovery</outgoing>
    </serviceTask>
    <sendTask id="T_SendDiscovery" name="Adaptive Kontextfragen senden" messageRef="Msg_discovery_questions">
      <incoming>Flow_T_Discovery__T_SendDiscovery</incoming>
      <outgoing>Flow_T_SendDiscovery__G_DiscoveryWait</outgoing>
    </sendTask>
    <eventBasedGateway id="G_DiscoveryWait" name="Auf Kontextantwort warten">
      <incoming>Flow_T_SendDiscovery__G_DiscoveryWait</incoming>
      <outgoing>Flow_G_DiscoveryWait__Catch_DiscoveryContext</outgoing>
      <outgoing>Flow_G_DiscoveryWait__Catch_DiscoveryTimeout</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Catch_DiscoveryContext" name="Kundenangaben erhalten">
      <incoming>Flow_G_DiscoveryWait__Catch_DiscoveryContext</incoming>
      <outgoing>Flow_Catch_DiscoveryContext__T_FrameworkPreview</outgoing>
      <messageEventDefinition id="Def_Catch_DiscoveryContext" messageRef="Msg_discovery_response"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_DiscoveryTimeout" name="Kontextantwortfrist">
      <incoming>Flow_G_DiscoveryWait__Catch_DiscoveryTimeout</incoming>
      <outgoing>Flow_Catch_DiscoveryTimeout__End_ContextTimeout</outgoing>
      <timerEventDefinition id="TimerDef_Catch_DiscoveryTimeout">
        <timeDuration>P14D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <endEvent id="End_ContextTimeout" name="Kein weiterer Kontext / pausiert">
      <incoming>Flow_Catch_DiscoveryTimeout__End_ContextTimeout</incoming>
    </endEvent>
    <businessRuleTask id="T_FrameworkPreview" name="Rahmenkandidaten &amp; offene Fragen vorschlagen">
      <incoming>Flow_Catch_DiscoveryContext__T_FrameworkPreview</incoming>
      <outgoing>Flow_T_FrameworkPreview__T_ProvisionalScope</outgoing>
    </businessRuleTask>
    <userTask id="T_ProvisionalScope" name="Ziel, Objekt und vorlaeufigen Scope abstimmen">
      <incoming>Flow_T_FrameworkPreview__T_ProvisionalScope</incoming>
      <incoming>Flow_Catch_OfferChange__T_ProvisionalScope</incoming>
      <outgoing>Flow_T_ProvisionalScope__T_SendOffer</outgoing>
    </userTask>
    <sendTask id="T_SendOffer" name="Leistungsbeschreibung / Angebot senden" messageRef="Msg_offer">
      <incoming>Flow_T_ProvisionalScope__T_SendOffer</incoming>
      <outgoing>Flow_T_SendOffer__G_OfferWait</outgoing>
    </sendTask>
    <eventBasedGateway id="G_OfferWait" name="Warten auf Mandatsreaktion">
      <incoming>Flow_T_SendOffer__G_OfferWait</incoming>
      <outgoing>Flow_G_OfferWait__Catch_Signed</outgoing>
      <outgoing>Flow_G_OfferWait__Catch_OfferDecline</outgoing>
      <outgoing>Flow_G_OfferWait__Catch_OfferChange</outgoing>
      <outgoing>Flow_G_OfferWait__Catch_OfferTimeout</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Catch_Signed" name="Beauftragung">
      <incoming>Flow_G_OfferWait__Catch_Signed</incoming>
      <outgoing>Flow_Catch_Signed__T_CreateMandate</outgoing>
      <messageEventDefinition id="Def_Catch_Signed" messageRef="Msg_signed"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_OfferDecline" name="Ablehnung">
      <incoming>Flow_G_OfferWait__Catch_OfferDecline</incoming>
      <outgoing>Flow_Catch_OfferDecline__End_OfferDeclined</outgoing>
      <messageEventDefinition id="Def_Catch_OfferDecline" messageRef="Msg_decline"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_OfferChange" name="Aenderungswunsch">
      <incoming>Flow_G_OfferWait__Catch_OfferChange</incoming>
      <outgoing>Flow_Catch_OfferChange__T_ProvisionalScope</outgoing>
      <messageEventDefinition id="Def_Catch_OfferChange" messageRef="Msg_changes"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_OfferTimeout" name="Angebotsfrist">
      <incoming>Flow_G_OfferWait__Catch_OfferTimeout</incoming>
      <outgoing>Flow_Catch_OfferTimeout__End_OfferExpired</outgoing>
      <timerEventDefinition id="TimerDef_Catch_OfferTimeout">
        <timeDuration>P21D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <endEvent id="End_OfferDeclined" name="Auftrag abgelehnt">
      <incoming>Flow_Catch_OfferDecline__End_OfferDeclined</incoming>
    </endEvent>
    <endEvent id="End_OfferExpired" name="Angebot abgelaufen">
      <incoming>Flow_Catch_OfferTimeout__End_OfferExpired</incoming>
    </endEvent>
    <serviceTask id="T_CreateMandate" name="Mandat mit Version und Rechten anlegen">
      <incoming>Flow_Catch_Signed__T_CreateMandate</incoming>
      <outgoing>Flow_T_CreateMandate__T_FinalScope</outgoing>
    </serviceTask>
    <userTask id="T_FinalScope" name="Assessment Scope, Kriterien und Datenrahmen finalisieren">
      <incoming>Flow_T_CreateMandate__T_FinalScope</incoming>
      <outgoing>Flow_T_FinalScope__T_EvidenceIntake</outgoing>
    </userTask>
    <serviceTask id="T_EvidenceIntake" name="Unterlagen / Fakten evidenzbezogen strukturieren">
      <incoming>Flow_T_FinalScope__T_EvidenceIntake</incoming>
      <incoming>Flow_Catch_Clarification__T_EvidenceIntake</incoming>
      <incoming>Flow_G_Rework__T_EvidenceIntake</incoming>
      <outgoing>Flow_T_EvidenceIntake__T_Readiness</outgoing>
    </serviceTask>
    <businessRuleTask id="T_Readiness" name="Materiale Informationsluecken beurteilen">
      <incoming>Flow_T_EvidenceIntake__T_Readiness</incoming>
      <outgoing>Flow_T_Readiness__G_Ready</outgoing>
    </businessRuleTask>
    <exclusiveGateway id="G_Ready" name="Entscheidungsfaehig?">
      <incoming>Flow_T_Readiness__G_Ready</incoming>
      <outgoing>Flow_G_Ready__T_RequestEvidence</outgoing>
      <outgoing>Flow_G_Ready__Call_Configure</outgoing>
    </exclusiveGateway>
    <sendTask id="T_RequestEvidence" name="Gezielte Klaerungsanfrage senden" messageRef="Msg_clarify">
      <incoming>Flow_G_Ready__T_RequestEvidence</incoming>
      <outgoing>Flow_T_RequestEvidence__G_ClarifyWait</outgoing>
    </sendTask>
    <eventBasedGateway id="G_ClarifyWait" name="Auf Antwort oder Frist warten">
      <incoming>Flow_T_RequestEvidence__G_ClarifyWait</incoming>
      <outgoing>Flow_G_ClarifyWait__Catch_Clarification</outgoing>
      <outgoing>Flow_G_ClarifyWait__Catch_ClarifyTimeout</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Catch_Clarification" name="Klaerungsinformationen">
      <incoming>Flow_G_ClarifyWait__Catch_Clarification</incoming>
      <outgoing>Flow_Catch_Clarification__T_EvidenceIntake</outgoing>
      <messageEventDefinition id="Def_Catch_Clarification" messageRef="Msg_clarification"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Catch_ClarifyTimeout" name="Klaerungsfrist">
      <incoming>Flow_G_ClarifyWait__Catch_ClarifyTimeout</incoming>
      <outgoing>Flow_Catch_ClarifyTimeout__T_MaterialDecision</outgoing>
      <timerEventDefinition id="TimerDef_Catch_ClarifyTimeout">
        <timeDuration>P14D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <userTask id="T_MaterialDecision" name="Umgang mit Limitations / Abbruch entscheiden">
      <incoming>Flow_Catch_ClarifyTimeout__T_MaterialDecision</incoming>
      <outgoing>Flow_T_MaterialDecision__G_Limit</outgoing>
    </userTask>
    <exclusiveGateway id="G_Limit" name="Begrenzter Abschluss erlaubt?">
      <incoming>Flow_T_MaterialDecision__G_Limit</incoming>
      <outgoing>Flow_G_Limit__End_Stopped</outgoing>
      <outgoing>Flow_G_Limit__Call_Configure</outgoing>
    </exclusiveGateway>
    <endEvent id="End_Stopped" name="Abbruch / nicht beurteilbar">
      <incoming>Flow_G_Limit__End_Stopped</incoming>
    </endEvent>
    <callActivity id="Call_Configure" name="Scope, Regulatorik, Assurance, Requirements" calledElement="Process_AssessmentSetup">
      <incoming>Flow_G_Limit__Call_Configure</incoming>
      <incoming>Flow_G_Ready__Call_Configure</incoming>
      <incoming>Flow_G_Rework__Call_Configure</incoming>
      <outgoing>Flow_Call_Configure__Call_Assess</outgoing>
    </callActivity>
    <callActivity id="Call_Assess" name="Assessment durchfuehren" calledElement="Process_AssessmentExecution">
      <incoming>Flow_Call_Configure__Call_Assess</incoming>
      <incoming>Flow_G_Rework__Call_Assess</incoming>
      <outgoing>Flow_Call_Assess__T_Draft</outgoing>
    </callActivity>
    <serviceTask id="T_Draft" name="Berichtsentwurf + Findings Register erstellen">
      <incoming>Flow_Call_Assess__T_Draft</incoming>
      <outgoing>Flow_T_Draft__T_LeadReview</outgoing>
    </serviceTask>
    <userTask id="T_LeadReview" name="Fachlichen Ergebnisreview vornehmen">
      <incoming>Flow_T_Draft__T_LeadReview</incoming>
