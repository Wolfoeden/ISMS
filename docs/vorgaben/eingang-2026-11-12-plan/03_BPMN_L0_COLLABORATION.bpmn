    <sequenceFlow id="Flow_A_Enough__A_Clarify" sourceRef="A_Enough" targetRef="A_Clarify" name="Klaerung"/>
    <sequenceFlow id="Flow_A_Clarify__A_AssessEvidence" sourceRef="A_Clarify" targetRef="A_AssessEvidence"/>
    <sequenceFlow id="Flow_A_Enough__A_Persist" sourceRef="A_Enough" targetRef="A_Persist" name="verifiziert"/>
    <sequenceFlow id="Flow_A_Persist__A_End" sourceRef="A_Persist" targetRef="A_End"/>
  </process>
