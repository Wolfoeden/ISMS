  <process id="Process_AssessmentSetup" name="Reusable Assessment Setup / configuration" isExecutable="false">
    <documentation>Descriptive L0/L1 reference. isExecutable=false. Execution requires message correlation, services, DMN bindings, explicit policies, exception/timeout handling and authorization. See Markdown specifications.</documentation>
    <laneSet id="LaneSet_Setup">
      <lane id="Lane_Setup_Agent" name="Agents / Decision Services">
        <flowNodeRef>S_Start</flowNodeRef>
        <flowNodeRef>S_RegRules</flowNodeRef>
